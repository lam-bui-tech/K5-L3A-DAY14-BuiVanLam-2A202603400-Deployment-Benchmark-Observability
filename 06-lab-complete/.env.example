# ============================================================
# Biến môi trường của agent. KHÔNG ghi secret thật vào file này.
# Dùng: cp .env.example .env  (file .env đã nằm trong .gitignore)
# Trên Railway/Render: đặt AGENT_API_KEY, REDIS_URL... trong phần Variables của nền tảng.
# ============================================================
PORT=8000
ENVIRONMENT=development
# Bắt buộc. Thiếu hoặc để trống → mọi request /ask bị 401
AGENT_API_KEY=
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_PER_MINUTE=10
DAILY_BUDGET_USD=1.0
# 0 = không giới hạn theo tháng
MONTHLY_BUDGET_USD=0
